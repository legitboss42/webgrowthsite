# Server-side WhatsApp Cloud API configuration. Never expose these values to the browser.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1192139290658384
WHATSAPP_BUSINESS_ACCOUNT_ID=987693860957754
WHATSAPP_API_VERSION=v26.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Legacy fallback only; prefer WHATSAPP_WEBHOOK_VERIFY_TOKEN above.
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Server-side Supabase credentials. Used by the WhatsApp webhook, the scheduler
# and the /automation waitlist store. Service-role only: never expose either of
# these to the browser and never prefix them with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- /automation waitlist ---------------------------------------------------
# The waitlist page needs no variables of its own. It reuses, all server-side:
#   SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY  storage for automation_waitlist
#   BREVO_API_KEY                             confirmation email transport
#   BREVO_FROM_EMAIL + BREVO_FROM_NAME        authenticated Web Growth sender
#   TURNSTILE_SECRET_KEY                      server-side spam verification
#   INTERNAL_TOOL_PASSPHRASE + _SESSION_SECRET  /admin/waitlist sign-in
# Only NEXT_PUBLIC_TURNSTILE_SITE_KEY reaches the browser, which is by design:
# a Turnstile site key is public. Never commit real values in this file.
